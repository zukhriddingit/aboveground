# Copy to backend/.env (gitignored) and fill in what you have. Everything is optional.
# Gemini Developer API key: AI delay translations, Tourist narration and the T-Feed Line Pulse.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Claude API key: used for the same AI text while no Gemini key is set (Gemini wins once it's added).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_PROVIDER=claude   # force one provider when both keys are set
# MBTA V3 key: 1,000 requests a minute instead of ~20 (https://api-v3.mbta.com/register).
MBTA_API_KEY=
# WORLD_LIVE=0      # mock trains only, never call the MBTA
# AI_DISABLED=1     # always use the template answers
